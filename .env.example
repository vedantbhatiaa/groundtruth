# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Neo4j (structured knowledge graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
# Separate read-only user for the chatbot's Cypher queries. Create this user
# in Neo4j with only MATCH/read privileges — see docs/setup.md.
NEO4J_READONLY_USER=groundtruth_reader
NEO4J_READONLY_PASSWORD=changeme_too

# --- LLM ---
# Free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Vector store (ChromaDB, embedded — no server, no key needed) ---
CHROMA_PERSIST_DIR=./data/chroma

# --- SQLite (document cache + query logs) ---
SQLITE_PATH=./data/groundtruth.db

# --- External data sources (all free, no key required) ---
GDELT_DOC_API=https://api.gdeltproject.org/api/v2/doc/doc
SEC_EDGAR_BASE=https://www.sec.gov/cgi-bin/browse-edgar
# SEC EDGAR requires a descriptive User-Agent identifying you, not a key
SEC_EDGAR_USER_AGENT="Groundtruth research prototype you@example.com"

# --- App ---
API_CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
